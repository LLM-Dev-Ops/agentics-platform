{
  "name": "@agentics/erp-surface",
  "version": "0.1.0",
  "description": "ERP Integration Surface - Canonical capability and event contract definitions",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
