    "./schemas": {
      "import": "./dist/schemas/index.mjs",
      "require": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest"
  },
  "dependencies": {},
  "devDependencies": {},
  "files": [
    "dist",
    "schemas"
  ],
  "keywords": [
    "erp",
    "integration",
    "surface",
    "contracts",
    "schemas"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agentics/agentics-platform.git",
    "directory": "packages/erp-surface"
  },
  "license": "UNLICENSED",
