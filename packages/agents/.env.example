# =============================================================================
# AGENTICS-DEV-PLATFORM AGENTS SERVICE - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure for your environment.
# In production, use Google Cloud Secret Manager (see cloudbuild-agents.yaml)
# =============================================================================

# -----------------------------------------------------------------------------
# SERVICE IDENTIFICATION
# -----------------------------------------------------------------------------
SERVICE_NAME=agentics-agents
SERVICE_VERSION=0.1.0
NODE_ENV=development
PLATFORM_ENV=dev

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# RUVECTOR SERVICE (REQUIRED)
# -----------------------------------------------------------------------------
# ALL persistence MUST go through ruvector-service
# agentics-dev-platform does NOT connect directly to Google SQL
RUVECTOR_SERVICE_URL=https://ruvvector-service-1062287243982.us-central1.run.app
RUVECTOR_API_KEY=your-ruvector-api-key-here

# Optional: Connection settings
RUVECTOR_TIMEOUT_MS=30000
RUVECTOR_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# TELEMETRY (LLM-Observatory)
# -----------------------------------------------------------------------------
TELEMETRY_ENDPOINT=https://llm-observatory-1062287243982.us-central1.run.app
TELEMETRY_CONSOLE_LOGGING=false

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false

# -----------------------------------------------------------------------------
# AGENT-SPECIFIC CONFIGURATION
# -----------------------------------------------------------------------------
# Decision Agent
DECISION_AGENT_ENABLED=true
DECISION_AGENT_DRY_RUN=false

# Executive Summary Agent
EXECUTIVE_SUMMARY_AGENT_ENABLED=true
EXECUTIVE_SUMMARY_MAX_LENGTH=5000

# Risk Scoring Agent
RISK_SCORING_AGENT_ENABLED=true
RISK_SCORING_DEFAULT_METHODOLOGY=hybrid
RISK_SCORING_HIGH_THRESHOLD=70

# -----------------------------------------------------------------------------
# UPSTREAM DEPENDENCIES (READ-ONLY)
# -----------------------------------------------------------------------------
# These services emit DecisionEvents consumed by this platform
# agentics-dev-platform MAY READ from these via ruvector-service

# Research Lab
RESEARCH_LAB_ENABLED=true

# Analytics Hub
ANALYTICS_HUB_ENABLED=true

# CostOps
COSTOPS_ENABLED=true

# -----------------------------------------------------------------------------
# DOWNSTREAM CONSUMERS
# -----------------------------------------------------------------------------
# Systems that consume outputs from agentics-dev-platform

# Governance Dashboard
GOVERNANCE_DASHBOARD_URL=https://governance.agentics.dev

# Audit System
AUDIT_SYSTEM_URL=https://audit.agentics.dev

# Executive Dashboard
EXECUTIVE_DASHBOARD_URL=https://executive.agentics.dev
