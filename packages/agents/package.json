{
  "name": "@agentics/agents",
  "version": "0.1.0",
  "description": "Agentics Dev Platform Agent Infrastructure - Executive Decisioning, Synthesis, and Platform Governance",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "agentics-agent": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js",
      "types": "./dist/cli/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "cli": "node --loader ts-node/esm src/cli/index.ts"
  },
  "dependencies": {
    "@agentics/contracts": "*",
    "@agentics/ruvector-client": "*",
    "@agentics/shared": "*",
    "commander": "^11.1.0",
    "fastify": "^5.12.8",
    "uuid": "^14.0.3",
    "pino": "^8.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "agentics",
    "agents",
    "decision-synthesis",
    "executive-reporting",
    "risk-scoring",
    "governance"
  ]
}
